rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // User profiles collection
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isOwner(userId);
      
      // Users can create their own profile
      allow create: if isOwner(userId) 
                    && request.resource.data.uid == userId
                    && request.resource.data.email is string;
      
      // Users can update their own profile
      allow update: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.email == resource.data.email; // Email cannot be changed
      
      // Users cannot delete their profile (optional - remove this line to allow deletion)
      allow delete: if false;
    }
    
    // Property listings collection
    match /listings/{listingId} {
      // Anyone can read approved listings (for public browsing)
      allow read: if resource.data.status == "approved" || isOwner(resource.data.userId);
      
      // Only authenticated users can create listings
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status in ["draft", "pending"]
                    && request.resource.data.hostEmail is string
                    && request.resource.data.propertyName is string;
      
      // Owner can update their listing, OR authenticated users can update averageRating/reviewCount
      allow update: if isOwner(resource.data.userId)
                    || (isSignedIn() 
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['averageRating', 'reviewCount']));
      
      // Only the owner can delete their listing
      allow delete: if isOwner(resource.data.userId);
    }
    
    // Reservations/bookings collection
    match /reservations/{reservationId} {
      // Users can read their own reservations (as guest) or reservations for their listings (as host)
      allow read: if isSignedIn() 
                  && (request.auth.uid == resource.data.userId 
                      || request.auth.uid == resource.data.hostId);
      
      // Only authenticated users can create reservations
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.listingId is string
                    && request.resource.data.checkInDate is timestamp
                    && request.resource.data.checkOutDate is timestamp
                    && request.resource.data.total is number;
      
      // Only the guest (userId) can update their reservation
      allow update: if isOwner(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId // Cannot transfer ownership
                    && request.resource.data.listingId == resource.data.listingId; // Cannot change listing
      
      // Only the guest can delete their reservation
      allow delete: if isOwner(resource.data.userId);
    }
    
    // Reviews collection
    match /reviews/{reviewId} {
      // Anyone can read reviews (for displaying on listings and testimonials)
      // Also allows authenticated users to check if they've already reviewed
      allow read: if true;
      
      // Only authenticated users can create reviews
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.userName is string
                    && request.resource.data.listingId is string
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.comment is string
                    && request.resource.data.createdAt is timestamp;
      
      // Only the review author can update their review
      allow update: if isOwner(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId // Cannot transfer ownership
                    && request.resource.data.listingId == resource.data.listingId; // Cannot change listing
      
      // Only the review author can delete their review
      allow delete: if isOwner(resource.data.userId);
    }
    
    // Message threads collection
    match /messageThreads/{threadId} {
      // Users can read threads where they are either the host or the guest
      allow read: if isSignedIn() 
                  && (request.auth.uid == resource.data.hostId 
                      || request.auth.uid == resource.data.guestId);
      
      // Only authenticated users can create threads for their reservations
      allow create: if isSignedIn()
                    && request.resource.data.reservationId is string
                    && (request.resource.data.hostId == request.auth.uid 
                        || request.resource.data.guestId == request.auth.uid)
                    && request.resource.data.propertyName is string
                    && request.resource.data.createdAt is timestamp;
      
      // Thread participants (host or guest) can update thread (for lastMessage updates)
      allow update: if isSignedIn()
                    && (request.auth.uid == resource.data.hostId 
                        || request.auth.uid == resource.data.guestId);
      
      // Thread participants can delete the thread
      allow delete: if isSignedIn()
                    && (request.auth.uid == resource.data.hostId 
                        || request.auth.uid == resource.data.guestId);
    }
    
    // Messages collection
    match /messages/{messageId} {
      // Users can read messages from threads where they are a participant
      // We need to check the threadId against messageThreads collection
      allow read: if isSignedIn();
      
      // Only authenticated users can create messages in threads they participate in
      allow create: if isSignedIn()
                    && request.resource.data.senderId == request.auth.uid
                    && request.resource.data.threadId is string
                    && request.resource.data.senderName is string
                    && request.resource.data.text is string
                    && request.resource.data.createdAt is timestamp;
      
      // Message sender can update their message (for editing)
      allow update: if isOwner(resource.data.senderId);
      
      // Message sender can delete their message
      allow delete: if isOwner(resource.data.senderId);
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
